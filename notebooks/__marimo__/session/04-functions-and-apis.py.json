            "text/html": "<pre class='text-xs'>106.25</pre>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "SFPL",
      "code_hash": "5f64dd94c496a257231a6d32da4385f6",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">If the tax rate changes, you edit the one line inside <code>add_tax</code>, and every call uses the new rate.</span></span>"
          }
        }
